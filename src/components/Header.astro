---
const pathname = Astro.url.pathname;
const nav = [
  { href: '/projets/', label: 'Projets' },
  { href: '/experience/', label: 'Expérience' },
  { href: '/a-propos/', label: 'À propos' },
  { href: '/contact/', label: 'Contact' }
];
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="logo" href="/" aria-label="Accueil Axel KAMGAING KOM">
      <span class="logo-icon"></span>
      <span>Axel KAMGAING KOM</span>
    </a>
    <nav class="nav-links" aria-label="Navigation principale">
      {nav.map((item) => (
        <a href={item.href} class={pathname.startsWith(item.href) ? 'active' : ''}>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <button class="btn-icon theme-toggle" type="button" aria-label="Changer de thème">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</header>
