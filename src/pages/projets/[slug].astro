---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDiagram from '../../components/ProjectDiagram.astro';
import { projects, type Project, type ProjectSection } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---
<BaseLayout title={`${project.title} — Axel KAMGAING KOM`} description={project.summary}>
  <article class="shell project-detail-article">
    <!-- Fil d'Ariane -->
    <nav class="breadcrumb-nav" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a>
      <span class="sep">/</span>
      <a href="/projets/">Projets</a>
      <span class="sep">/</span>
      <span class="current">{project.shortTitle}</span>
    </nav>

    <!-- En-tête du projet -->
    <header class="project-detail-header">
      <div class="detail-meta-pill">
        <span class="category-tag-soft">{project.category}</span>
        <span class="date-tag-soft">{project.date}</span>
        <span class="status-pill-soft">{project.status}</span>
      </div>
      <h1 class="project-detail-title">{project.title}</h1>
      <p class="project-detail-intro">{project.intro}</p>

      <!-- Stack technique -->
      <div class="detail-stack-row">
        <span class="stack-label">Technologies :</span>
        <div class="project-stack-wrap">
          {project.stack.map((item: string) => (
            <span class="tech-chip">{item}</span>
          ))}
        </div>
      </div>
    </header>

    <!-- Topologie & Diagramme interactif -->
    {project.diagram && project.diagram.nodes && project.diagram.nodes.length > 0 && (
      <div class="detail-diagram-container">
        <div class="diagram-header">
          <span class="diagram-title-text">Topologie du laboratoire & flux observés</span>
        </div>
        <ProjectDiagram nodes={project.diagram.nodes} links={project.diagram.links} label={`Topologie ${project.shortTitle}`} />
      </div>
    )}

    <!-- Sections techniques détaillées -->
    <div class="detail-sections-container">
      {project.sections.map((section: ProjectSection, idx: number) => (
        <section class="technical-section-block">
          <div class="section-num-pill">Phase {idx + 1}</div>
          <h2 class="technical-section-title">{section.title}</h2>
          
          <div class="technical-section-body">
            {section.body.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </div>

          {section.points && section.points.length > 0 && (
            <ul class="technical-points-list">
              {section.points.map((pt: string) => (
                <li>{pt}</li>
              ))}
            </ul>
          )}

          {section.code && (
            <div class="code-snippet-box">
              <div class="code-header">
                <span class="code-dot"></span>
                <span class="code-filename">commandes-execution.sh</span>
              </div>
              <pre><code>{section.code}</code></pre>
            </div>
          )}
        </section>
      ))}
    </div>

    <!-- Navigation retour -->
    <div class="detail-footer-nav">
      <a href="/projets/" class="btn-soft-secondary">← Retour à la liste des projets</a>
      <a href="/contact/" class="btn-soft-primary">Discuter de cette architecture →</a>
    </div>
  </article>
</BaseLayout>
