---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';

const pWazuh = projects.find(p => p.slug === 'wazuh')!;
const pAd = projects.find(p => p.slug === 'active-directory-gpo')!;
const pSplunk = projects.find(p => p.slug === 'splunk')!;
const pAudit = projects.find(p => p.slug === 'audit-securite')!;
const pVeeam = projects.find(p => p.slug === 'veeam')!;
const pVsphere = projects.find(p => p.slug === 'vsphere')!;
---
<BaseLayout title="Axel KAMGAING KOM — Systèmes, Réseaux & Cybersécurité">
  <!-- Apple Billboard Hero -->
  <section class="shell hero-apple">
    <div class="eyebrow-pill">
      <span>INGÉNIERIE SYSTÈMES & CYBERSÉCURITÉ</span>
    </div>
    <h1 class="headline-apple">
      Concevoir. Sécuriser.<br/>Superviser avec rigueur.
    </h1>
    <p class="lead-apple">
      Laboratoires d'infrastructures réelles, architectures résilientes et détection d'intrusions documentés en profondeur par Axel KAMGAING KOM.
    </p>
    <div class="hero-cta-group">
      <a class="cta-primary" href="/projets/">Explorer les projets <span>↗</span></a>
      <a class="cta-secondary" href="/experience/">Consulter le parcours</a>
    </div>
  </section>

  <!-- Bento Grid Showcase (Apple style) -->
  <section class="shell bento-section">
    <div class="bento-head">
      <h2>Dossiers d'Ingénierie & Preuves Techniques</h2>
      <p>Études de cas réelles avec topologies, configurations et validation de tests.</p>
    </div>

    <div class="bento-grid">
      <!-- Card 1: Wazuh (Col 8) -->
      <article class="bento-card col-8">
        <div>
          <span class="bento-badge">{pWazuh.category} · SIEM & EDR</span>
          <h3 class="bento-title">{pWazuh.title}</h3>
          <p class="bento-desc">{pWazuh.summary}</p>
        </div>
        <a class="bento-link" href={`/projets/${pWazuh.slug}/`}>Consulter l'étude complète →</a>
      </article>

      <!-- Card 2: AD & GPO (Col 4) -->
      <article class="bento-card col-4">
        <div>
          <span class="bento-badge">{pAd.category} · Identités</span>
          <h3 class="bento-title">{pAd.title}</h3>
          <p class="bento-desc">{pAd.summary}</p>
        </div>
        <a class="bento-link" href={`/projets/${pAd.slug}/`}>Consulter l'étude complète →</a>
      </article>

      <!-- Card 3: Splunk (Col 4) -->
      <article class="bento-card col-4">
        <div>
          <span class="bento-badge">{pSplunk.category} · Supervision</span>
          <h3 class="bento-title">{pSplunk.title}</h3>
          <p class="bento-desc">{pSplunk.summary}</p>
        </div>
        <a class="bento-link" href={`/projets/${pSplunk.slug}/`}>Consulter l'étude complète →</a>
      </article>

      <!-- Card 4: Audit CEH (Col 4) -->
      <article class="bento-card col-4">
        <div>
          <span class="bento-badge">{pAudit.category} · Sécurité Offensive</span>
          <h3 class="bento-title">{pAudit.title}</h3>
          <p class="bento-desc">{pAudit.summary}</p>
        </div>
        <a class="bento-link" href={`/projets/${pAudit.slug}/`}>Consulter l'étude complète →</a>
      </article>

      <!-- Card 5: Veeam (Col 4) -->
      <article class="bento-card col-4">
        <div>
          <span class="bento-badge">{pVeeam.category} · PRA & PCA</span>
          <h3 class="bento-title">{pVeeam.title}</h3>
          <p class="bento-desc">{pVeeam.summary}</p>
        </div>
        <a class="bento-link" href={`/projets/${pVeeam.slug}/`}>Consulter l'étude complète →</a>
      </article>

      <!-- Card 6: vSphere Cluster (Col 12) -->
      <article class="bento-card col-12">
        <div>
          <span class="bento-badge">{pVsphere.category} · Virtualisation Datacenter</span>
          <h3 class="bento-title">{pVsphere.title}</h3>
          <p class="bento-desc">{pVsphere.summary}</p>
        </div>
        <a class="bento-link" href={`/projets/${pVsphere.slug}/`}>Consulter l'étude complète →</a>
      </article>
    </div>
  </section>
</BaseLayout>
