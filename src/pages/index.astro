---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects, type Project } from '../data/projects';

const featured = projects.slice(0, 4);
---
<BaseLayout
  title="Axel KAMGAING KOM — Ingénieur Systèmes, Réseaux & Cybersécurité"
  description="Portfolio d'Axel KAMGAING KOM. Projets techniques documentés, infrastructures réelles, supervision et cybersécurité."
>
  <!-- Hero Section : Sobre, soft, inspiré de komiapply et du profil d'origine -->
  <section class="shell hero-soft">
    <div class="hero-badge-pill">
      <span class="status-dot-active"></span>
      <span>Disponible pour opportunités · Région parisienne & Mobilité</span>
    </div>
    
    <h1 class="hero-title">
      Axel KAMGAING KOM<br />
      <span class="hero-subtitle-dim">Ingénierie Systèmes, Réseaux & Cybersécurité</span>
    </h1>
    
    <p class="hero-bio-soft">
      Jeune diplômé en Master Systèmes, Réseaux et Cybersécurité (ESIPE / Université Gustave Eiffel). 
      Passionné par l'architecture des infrastructures, le durcissement des annuaires, la détection d'incidents (SIEM/SOC) et la résilience opérationnelle.
    </p>

    <div class="hero-actions-group">
      <a href="/projets/" class="btn-soft-primary">
        Explorer les projets documentés
        <span class="btn-arrow">→</span>
      </a>
      <a href="/experience/" class="btn-soft-secondary">
        Consulter le parcours
      </a>
      <a href="/contact/" class="btn-soft-outline">
        Me contacter
      </a>
    </div>

    <!-- Terminal Quick-Card / Whoami inspiré du portfolio d'origine -->
    <div class="terminal-card-soft">
      <div class="terminal-bar">
        <span class="t-dot t-red"></span>
        <span class="t-dot t-yellow"></span>
        <span class="t-dot t-green"></span>
        <span class="terminal-title-text">axel@infra-lab: ~ (whoami)</span>
      </div>
      <div class="terminal-body-code">
        <div class="terminal-line"><span class="t-prompt">$</span> <span class="t-cmd">whoami --verbose</span></div>
        <div class="terminal-out">Axel KAMGAING KOM · Ingénieur Cybersécurité & Systèmes (FCA Fortinet)</div>
        <div class="terminal-line"><span class="t-prompt">$</span> <span class="t-cmd">cat /etc/core-skills</span></div>
        <div class="terminal-out t-skills">Active Directory (AD DS/GPO) · Wazuh SIEM · Splunk · VMware vSphere · Proxmox VE · Veeam PRA · Cisco OSPF/VLAN · Fortinet</div>
      </div>
    </div>
  </section>

  <!-- Section Projets phares -->
  <section class="shell section-soft">
    <div class="section-header-row">
      <div>
        <h2 class="section-heading-soft">Dossiers d'Ingénierie & Preuves Techniques</h2>
        <p class="section-desc-soft">7 laboratoires documentés de bout en bout avec architectures, configurations et tests.</p>
      </div>
      <a href="/projets/" class="view-all-link">Tous les projets ({projects.length}) →</a>
    </div>

    <div class="projects-grid-soft">
      {featured.map((project: Project) => (
        <article class="project-card-soft">
          <div class="project-card-header">
            <span class="category-tag-soft">{project.category}</span>
            <span class="date-tag-soft">{project.date}</span>
          </div>
          <h3 class="project-title-soft">
            <a href={`/projets/${project.slug}/`}>{project.title}</a>
          </h3>
          <p class="project-summary-soft">{project.summary}</p>
          
          <div class="project-stack-wrap">
            {project.stack.slice(0, 4).map((tech: string) => (
              <span class="tech-chip">{tech}</span>
            ))}
          </div>

          <div class="project-card-footer">
            <span class="sections-count">{project.sections.length} sections techniques</span>
            <a href={`/projets/${project.slug}/`} class="read-more-link">
              Consulter le dossier <span>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Section Chiffres & Atouts -->
  <section class="shell section-soft">
    <div class="stats-grid-soft">
      <div class="stat-box-soft">
        <span class="stat-number">Bac+5</span>
        <span class="stat-label">Master Ingénieur Réseaux & Sécurité (ESIPE)</span>
      </div>
      <div class="stat-box-soft">
        <span class="stat-number">FCA</span>
        <span class="stat-label">Fortinet Certified Associate in Cybersecurity</span>
      </div>
      <div class="stat-box-soft">
        <span class="stat-number">7</span>
        <span class="stat-label">Laboratoires d'infrastructures & PRA complets</span>
      </div>
      <div class="stat-box-soft">
        <span class="stat-number">3+ ans</span>
        <span class="stat-label">Expérience pratique en support & administration</span>
      </div>
    </div>
  </section>
</BaseLayout>
