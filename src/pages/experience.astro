---
import BaseLayout from '../layouts/BaseLayout.astro';

const roles = [
  {
    dates: 'Nov. 2022 — Oct. 2023',
    role: 'Administrateur Réseaux & Systèmes',
    org: 'Stones and Gold',
    context: 'CDI · Infrastructure & Production',
    missions: [
      'Supervision proactive du parc de serveurs avec Centreon (définition des seuils critiques, escalade et métrologie).',
      'Plan de sauvegarde et restauration des machines virtuelles critiques avec Veeam Backup & Replication ; support N1/N2.',
      'Administration globale Active Directory (AD DS, contrôleurs de domaine, règles GPO durcies et gestion des habilitations).',
      'Déploiement MFA, chiffrement des disques, centralisation et analyse de sécurité des logs Splunk, réalisation d’audits internes.'
    ]
  },
  {
    dates: 'Janv. 2022 — Août 2022',
    role: 'Assistant Administrateur Réseaux',
    org: 'SIGERIS SARL',
    context: 'Stage & Mission · Ingénierie Réseau',
    missions: [
      'Déploiement et segmentation de commutateurs managés : VLANs par service, Spanning Tree (STP) et priorisation QoS.',
      'Configuration du routage dynamique OSPF et BGP, filtrage par listes de contrôle d’accès (ACLs) sur équipements Cisco.',
      'Gestion des services d’infrastructure DHCP, DNS, FTP et annuaire Active Directory ; tests de performance et procédures.'
    ]
  },
  {
    dates: 'Juil. 2019 — Août 2019',
    role: 'Stagiaire Télécoms & VoIP',
    org: 'IUEs / INSAM',
    context: 'Stage académique · Bafoussam',
    missions: [
      'Conception et intégration d’un commutateur IPBX sous Linux avec Asterisk.',
      'Configuration et répartition des postes SIP, plans de numérotation, validation des flux voix et rédaction des guides.'
    ]
  },
  {
    dates: 'Sept. 2016 — Juil. 2018',
    role: 'Technicien Informatique',
    org: 'Envol Learn and Travel',
    context: 'Support & Maintenance',
    missions: [
      'Surveillance continue des services réseau avec Nagios et gestion rigoureuse des incidents via la billetterie GLPI.',
      'Dépannage matériel, déploiement système, câblage et maintenance de caméras de vidéosurveillance IP.',
      'Sensibilisation des collaborateurs aux bonnes pratiques d’hygiène informatique et sécurité des mots de passe.'
    ]
  }
];

const education = [
  {
    period: '2023 — 2025',
    title: 'Master Ingénieur en Systèmes, Réseaux et Cybersécurité',
    school: 'ESIPE / Université Gustave Eiffel · France',
    level: 'Niveau 7 (Bac+5)'
  },
  {
    period: 'Février 2024',
    title: 'Fortinet Certified Associate in Cybersecurity (FCA)',
    school: 'Fortinet Training Institute',
    level: 'Certification'
  },
  {
    period: '2020 — 2021',
    title: 'Licence Pro Administrateur Systèmes et Réseaux',
    school: 'IUEs / INSAM · Douala',
    level: 'Bac+3'
  },
  {
    period: '2019 — 2020',
    title: 'BTS Réseaux et Sécurité',
    school: 'IUEs / INSAM · Bafoussam',
    level: 'Bac+2'
  }
];

const skillPillars = [
  { name: 'Réseaux & Routage', items: 'TCP/IP, VLAN 802.1Q, OSPF, BGP, NAT, ACL, QoS, VPN IPsec/OpenVPN, Cisco, FortiGate, pfSense' },
  { name: 'Systèmes & Annuaires', items: 'Windows Server (2019-2025), Debian, Ubuntu Server, Active Directory DS, GPO, DNS, DHCP, DFS, Samba' },
  { name: 'Cybersécurité', items: 'Wazuh SIEM/XDR, Splunk Enterprise, Wireshark, Nmap, durcissement CIS, MFA, segmentation, Burp Suite' },
  { name: 'Virtualisation & PRA', items: 'VMware vSphere (ESXi, vCenter, HA, DRS), Proxmox VE, Hyper-V, Veeam Backup & Replication, PBS' },
  { name: 'Supervision & ITSM', items: 'Centreon, Zabbix, Nagios, SNMP v2c/v3, GLPI, gestion des changements et documentation technique' },
  { name: 'Scripting & Automatisation', items: 'Bash, PowerShell, Python, Cloud-init, APIs REST Proxmox et Fortinet' }
];
---
<BaseLayout title="Expérience & Parcours — Axel KAMGAING KOM" description="Parcours professionnel et compétences techniques d'Axel KAMGAING KOM">
  <div class="shell">
    <header class="hero-block">
      <span class="section-label">Parcours & Compétences</span>
      <h1 class="hero-headline">Expérience & Formation</h1>
      <p class="hero-lead">
        Un parcours opérationnel en support et administration réseau/système, prolongé par une spécialisation d'ingénieur en cybersécurité des infrastructures.
      </p>
    </header>

    <!-- Expériences professionnelles -->
    <section class="page-section">
      <span class="section-label">01 / Postes occupés</span>
      <h2 class="section-heading">Expériences professionnelles</h2>
      
      <div>
        {roles.map(r => (
          <article class="exp-item">
            <div class="exp-header">
              <div>
                <h3 class="exp-title">{r.role}</h3>
                <div style="margin-top: 3px;">
                  <span class="exp-company">{r.org}</span>
                  <span style="color: var(--text-muted); margin: 0 6px;">·</span>
                  <span style="color: var(--text-muted); font-size: 0.9rem;">{r.context}</span>
                </div>
              </div>
              <span class="exp-period">{r.dates}</span>
            </div>
            <ul class="exp-list">
              {r.missions.map(m => (
                <li>{m}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <!-- Diplômes et certifications -->
    <section class="page-section">
      <span class="section-label">02 / Formation académique</span>
      <h2 class="section-heading">Diplômes & Certifications</h2>
      <div class="grid-2">
        {education.map(e => (
          <div class="jp-card">
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
              <span class="mono" style="font-size: 0.85rem; color: var(--text-muted);">{e.period}</span>
              <span class="jp-tag jp-tag-accent">{e.level}</span>
            </div>
            <h3 style="font-size: 1.15rem; margin-bottom: 6px;">{e.title}</h3>
            <p style="color: var(--text-muted); font-size: 0.92rem;">{e.school}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Compétences techniques -->
    <section class="page-section">
      <span class="section-label">03 / Matrice technique</span>
      <h2 class="section-heading">Compétences clés</h2>
      <div class="grid-3">
        {skillPillars.map(p => (
          <div class="jp-card">
            <h3 style="font-size: 1.05rem; margin-bottom: 10px; color: var(--accent);">{p.name}</h3>
            <p style="color: var(--text); font-size: 0.9rem; line-height: 1.55;">{p.items}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
