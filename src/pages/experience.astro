    title: 'Licence Professionnelle Administrateur Systèmes et Réseaux',
    institution: 'IUEs / INSAM · Douala, Cameroun',
    badge: 'Bac+3'
  },
  {
    dates: '2019 — 2020',
    title: 'BTS Réseaux et Sécurité',
    institution: 'IUEs / INSAM · Bafoussam, Cameroun',
    badge: 'Bac+2'
  }
];

const skillMatrix = [
  {
    category: 'Réseaux & Routage',
    desc: 'TCP/IP, LAN, WAN, VLAN 802.1Q, NAT, ACL, QoS, OSPF, BGP, VPN IPsec/OpenVPN, MPLS, commutateurs Cisco, FortiGate, pfSense.'
  },
  {
    category: 'Systèmes & Annuaires',
    desc: 'Windows Server (2019-2025), Debian, Ubuntu Server, Red Hat, Active Directory DS, DNS, DHCP, GPO, DFS, iSCSI, Samba.'
  },
  {
    category: 'Cybersécurité & Détection',
    desc: 'Wazuh SIEM/XDR, Splunk Enterprise, ELK, Wireshark, Nmap, durcissement CIS Benchmarks, MFA, segmentation réseau, Burp Suite.'
  },
  {
    category: 'Virtualisation & PRA/PCA',
    desc: 'VMware vSphere (ESXi, vCenter, vDS, HA, DRS), Proxmox VE, Hyper-V, Veeam Backup & Replication, VTL Quadstor, rétention PBS.'
  },
  {
    category: 'Supervision & Exploitation',
    desc: 'Centreon, Zabbix, Nagios, SNMP v2c/v3, GLPI (ITIL), gestion des changements, reporting et documentation technique d’architecture.'
  },
  {
    category: 'Automatisation & Scripts',
    desc: 'Bash, PowerShell, Python, Cloud-init, API REST Proxmox/Fortinet, industrialisation des déploiements et audits de conformité.'
  }
];
---
<BaseLayout title="Expérience & Compétences — Axel KAMGAING KOM" description="Parcours professionnel d'administrateur réseaux et systèmes, certifications et maîtrise technique.">
  <!-- Hero Section -->
  <header class="page-hero shell">
    <div class="eyebrow-pill">
      <span>PARCOURS & COMPÉTENCES</span>
    </div>
    <h1 class="headline-apple">Du terrain, des services<br/>et une méthode.</h1>
    <p class="lead-apple">
      Un parcours opérationnel en support et administration réseau/système, prolongé par une spécialisation d'ingénieur en cybersécurité des infrastructures.
    </p>
  </header>

  <!-- Section 01 : Expériences professionnelles -->
  <section class="section-apple shell">
    <div class="section-title-wrap">
      <span class="section-eyebrow">01 / PARCOURS OPÉRATIONNEL</span>
      <h2 class="section-title">Expériences professionnelles</h2>
    </div>

    <div class="cards-stack">
      {roles.map((item) => (
        <article class="experience-card">
          <div class="exp-top-row">
            <div class="exp-heading">
              <h3 class="exp-role">{item.role}</h3>
              <div class="exp-company-badge">
                <span class="company-name">{item.org}</span>
                <span class="badge-sep">·</span>
                <span class="contract-type">{item.type}</span>
              </div>
            </div>
            <span class="exp-period">{item.dates}</span>
          </div>
          <ul class="exp-missions-list">
            {item.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- Section 02 : Formations & Certifications -->
  <section class="section-apple shell">
    <div class="section-title-wrap">
      <span class="section-eyebrow">02 / FORMATION & CERTIFICATIONS</span>
      <h2 class="section-title">Diplômes et accréditations</h2>
    </div>

    <div class="bento-grid">
      {formations.map((f) => (
        <div class="bento-card col-6">
          <div>
            <span class="bento-badge">{f.dates}</span>
            <h3 class="bento-title" style="font-size: 1.25rem;">{f.title}</h3>
            <p class="bento-desc" style="margin-bottom: 0.8rem;">{f.institution}</p>
          </div>
          <div>
            <span class="pill-tag" style="color: var(--apple-blue); border-color: rgba(41, 151, 255, 0.3);">{f.badge}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Section 03 : Matrice de compétences -->
  <section class="section-apple shell">
    <div class="section-title-wrap">
      <span class="section-eyebrow">03 / MATRICE TECHNIQUE</span>
      <h2 class="section-title">Une lecture transversale du système</h2>
      <p class="section-lead">Les compétences sont articulées par pôle pour refléter la complémentarité réseau, identité, observabilité et résilience.</p>
    </div>

    <div class="bento-grid">
      {skillMatrix.map((s) => (
        <div class="bento-card col-4">
          <div>
            <span class="bento-badge">COMPÉTENCE CLÉ</span>
            <h3 class="bento-title" style="font-size: 1.18rem;">{s.category}</h3>
            <p class="bento-desc" style="font-size: 0.92rem;">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
