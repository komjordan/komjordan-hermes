const formations = [
  {
    dates: '2023 — 2025',
    title: 'Master Ingénieur en Systèmes, Réseaux et Cybersécurité',
    institution: 'ESIPE / Université Gustave Eiffel · Vincennes, France',
    badge: 'Niveau 7 (Bac+5)'
