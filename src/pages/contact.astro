---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Axel KAMGAING KOM" description="Prendre contact avec Axel KAMGAING KOM">
  <div class="shell">
    <header class="hero-block">
      <span class="section-label">Échange & Opportunités</span>
      <h1 class="hero-headline">Contact</h1>
      <p class="hero-lead">
        À l'écoute d'opportunités professionnelles en ingénierie systèmes, réseaux et cybersécurité.
      </p>
    </header>

    <section class="page-section">
      <div class="grid-2">
        <div class="jp-card">
          <span class="section-label">Coordonnées directes</span>
          <h2 style="font-size: 1.25rem; margin-bottom: 16px;">Pour me joindre</h2>
          <ul style="display: flex; flex-direction: column; gap: 12px; font-size: 0.95rem;">
            <li>
              <span style="color: var(--text-muted); display: block; font-size: 0.82rem;">EMAIL</span>
              <a href="mailto:axel@komjordan.fr" style="color: var(--accent); font-weight: 500;">axel@komjordan.fr</a>
            </li>
            <li>
              <span style="color: var(--text-muted); display: block; font-size: 0.82rem;">TÉLÉPHONE</span>
              <a href="tel:+33745497357" style="color: var(--text);">+33 7 45 49 73 57</a>
            </li>
            <li>
              <span style="color: var(--text-muted); display: block; font-size: 0.82rem;">LOCALISATION</span>
              <span>Île-de-France (mobilité nationale & internationale)</span>
            </li>
          </ul>
        </div>

        <div class="jp-card">
          <span class="section-label">Présence en ligne</span>
          <h2 style="font-size: 1.25rem; margin-bottom: 16px;">Réseaux & Plateformes</h2>
          <ul style="display: flex; flex-direction: column; gap: 12px; font-size: 0.95rem;">
            <li>
              <a href="https://www.linkedin.com/in/komjordan" target="_blank" rel="noreferrer" style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 6px;">
                <span>LinkedIn</span>
                <span style="color: var(--accent);">in/komjordan →</span>
              </a>
            </li>
            <li>
              <a href="https://github.com/komjordan" target="_blank" rel="noreferrer" style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 6px;">
                <span>GitHub</span>
                <span style="color: var(--accent);">@komjordan →</span>
              </a>
            </li>
            <li>
              <a href="https://komiapply.komjordan.fr" target="_blank" rel="noreferrer" style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 6px;">
                <span>KomiApply</span>
                <span style="color: var(--accent);">komiapply.komjordan.fr →</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
